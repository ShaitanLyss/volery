<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 14 refuses the microphone to an app that is not in front unless
         its foreground service declares this type: the ears are open while the
         screen is off, which is the whole of the walking mode. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Android 15 caps dataSync at six hours in the background per day. This
         service reads a private mesh all day, which is what specialUse is for;
         dataSync stays declared for the versions before 34 that have no
         specialUse at all. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- No backup, deliberately. The phrase this phone joins the flyway with
         is kept here, wrapped by a Keystore key that cannot leave the device,
         so a backup of it would be a file nothing could open — and a restore
         onto another phone would be a phone that looks configured and is not.
         The handful of preferences a backup would carry (theme, preferred
         wall) cost one tap to set again. -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.VoleryPhone">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".TutorialActivity"
            android:exported="false" />

        <activity
            android:name=".ViewerActivity"
            android:exported="false" />

        <service
            android:name=".NodeService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone|dataSync">
            <!-- The sentence the platform asks specialUse for. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="a node on the user's private peer-to-peer mesh, reading their own wall for questions that need them" />
        </service>
    </application>
</manifest>
