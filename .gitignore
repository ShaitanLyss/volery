.DS_Store
node_modules

# vite build output — `bun run build` regenerates it, and tauri build reads it from here
/dist
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# scratch working trees: the probes in tools/ are throwaway by definition, and
# test/wall.test.ts opens conversations under /.scratch/walltest. /.scratch itself
# is shared by every card on the wall — see "Scratch space" in CLAUDE.md, and use
# /.scratch-<your handle>/ for anything that has to outlive your next tool call.
/.scratch
/.scratch-*

# the windres shim tools/build-gnu.ps1 compiles from tools/windres-shim.c — a
# binary, and one built against whatever cygwin is on the machine
/.build-tools

# console logs and page snapshots the Playwright MCP drops while driving the
# app — dated debug output from one session, throwaway like /.scratch
/.playwright-mcp

.env
.env.*
!.env.example
